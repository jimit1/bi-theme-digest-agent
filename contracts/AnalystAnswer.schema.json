{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momentive-bi-digest.invalid/contracts/AnalystAnswer.schema.json",
  "title": "AnalystAnswer",
  "description": "The grounded answer the analyst agent returns. The analyst reads the theme store only and has no source access at all. If the store does not support an answer it must set supported to false, return zero citations and give a decline_reason. Both directions are enforced by the allOf below, so an unsupported answer cannot smuggle citations and a supported answer cannot arrive without one.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "type": "string",
      "description": "Contract version of this document. Bump minor for an additive change, major for a breaking one."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "supported": {
      "type": "boolean",
      "description": "True only when the store contains evidence for the answer."
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "theme_id": {
            "type": "string",
            "pattern": "^THEME-\\d{4}$"
          },
          "claim_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          }
        },
        "required": [
          "theme_id",
          "claim_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "decline_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    }
  },
  "required": [
    "schema_version",
    "question",
    "answer",
    "supported",
    "citations",
    "decline_reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "supported": {
            "const": false
          }
        },
        "required": [
          "supported"
        ]
      },
      "then": {
        "properties": {
          "citations": {
            "maxItems": 0
          },
          "decline_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "supported": {
            "const": true
          }
        },
        "required": [
          "supported"
        ]
      },
      "then": {
        "properties": {
          "citations": {
            "minItems": 1
          },
          "decline_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
