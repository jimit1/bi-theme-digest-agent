    "transcript": [
      {
        "speakerId": "2001",
        "topic": null,
        "sentences": [
          {
            "start": 0,
            "end": 29388,
            "text": "Good to see you, thanks for prioritizing this."
          },
          {
            "start": 29389,
            "end": 78367,
            "text": "Hey, glad we could get this on the calendar."
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 83265,
            "end": 107755,
            "text": "Hi, thanks for hopping on, good to see you."
          },
          {
            "start": 107756,
            "end": 122449,
            "text": "Hi, thanks for having us, ready when you are."
          }
        ]
      },
      {
        "speakerId": "2004",
        "topic": null,
        "sentences": [
          {
            "start": 127347,
            "end": 171429,
            "text": "Glad to make time for this, let's walk through the list."
          },
          {
            "start": 171430,
            "end": 191020,
            "text": "Sounds good, I have some time blocked so we can cover everything."
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 205714,
            "end": 225306,
            "text": "Before we get into it, things have been steady on our end overall."
          },
          {
            "start": 225307,
            "end": 274286,
            "text": "Overall we are in decent shape, just a couple of things worth flagging."
          }
        ]
      },
      {
        "speakerId": "2001",
        "topic": null,
        "sentences": [
          {
            "start": 288980,
            "end": 293878,
            "text": "Happy to take these in whatever order makes sense to you."
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 298776,
            "end": 303673,
            "text": "We need to be able to upload our existing SCORM 1.2 course packages and have them run inside the new learning module without rebuilding anything."
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 308571,
            "end": 323265,
            "text": "We have about 60 SCORM 1.2 modules built up over the last eight years covering our certification tracks."
          }
        ]
      },
      {
        "speakerId": "2001",
        "topic": null,
        "sentences": [
          {
            "start": 337959,
            "end": 382041,
            "text": "Thanks for the specifics, I have a quick question before we move on."
          },
          {
            "start": 382042,
            "end": 386939,
            "text": "How many of those packages would you need to move over on day one versus migrate gradually?"
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 396735,
            "end": 440816,
            "text": "We would want at least the 15 certification modules working immediately, the rest could follow over the first quarter."
          }
        ]
      },
      {
        "speakerId": "2001",
        "topic": null,
        "sentences": [
          {
            "start": 455510,
            "end": 475102,
            "text": "Switching gears for a second, anything else going on that I should know about?"
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 484898,
            "end": 499592,
            "text": "Our board likes to see a renewal update every month during this stretch."
          }
        ]
      },
      {
        "speakerId": "2004",
        "topic": null,
        "sentences": [
          {
            "start": 514286,
            "end": 543673,
            "text": "Appreciate you sharing that, it helps us plan around your calendar."
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 553469,
            "end": 592653,
            "text": "A few staff shifted departments after our reorg."
          }
        ]
      },
      {
        "speakerId": "2001",
        "topic": null,
        "sentences": [
          {
            "start": 607347,
            "end": 626939,
            "text": "Sounds like a busy stretch for the team, hope it eases up soon."
          }
        ]
      },
      {
        "speakerId": "c-07",
        "topic": null,
        "sentences": [
          {
            "start": 631837,
            "end": 661224,
            "text": "The renewal numbers are looking solid so far this year."
          }
        ]
      },
      {
        "speakerId": "2004",
        "topic": null,
        "sentences": [
          {
            "start": 671020,
            "end": 690612,
            "text": "Nice to hear the numbers are holding steady."
