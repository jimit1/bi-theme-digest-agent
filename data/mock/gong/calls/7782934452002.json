      },
      {
        "speakerId": "c-03",
        "topic": null,
        "sentences": [
          {
            "start": 728792,
            "end": 749614,
            "text": "It was the November 3rd renewal run, invoice C-88214, and Ridgeview's finance lead already flagged two more from the same batch."
