      {
        "speakerId": "c-03",
        "topic": null,
        "sentences": [
          {
            "start": 534447,
            "end": 596915,
            "text": "When one of our chapters upgrades partway through the year we get billed the full renewal amount again in the fall, with nothing knocked off for what was already collected."
          }
        ]
      },
      {
        "speakerId": "c-03",
        "topic": null,
        "sentences": [
          {
            "start": 617738,
            "end": 638560,
            "text": "Our Ridgeview chapter upgraded back in April, and when their November renewal came through the full 1,200 dollar amount posted with nothing subtracted for what they already paid."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 652442,
            "end": 673265,
            "text": "Thanks, that gives me a clearer picture, one follow up though."
          },
          {
            "start": 673266,
            "end": 707969,
            "text": "Can you tell me roughly how many accounts this hit on that last cycle, and do you have a specific invoice number or date I can pull up?"
