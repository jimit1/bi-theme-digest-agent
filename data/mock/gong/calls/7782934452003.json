      {
        "speakerId": "c-03",
        "topic": null,
        "sentences": [
          {
            "start": 319778,
            "end": 325928,
            "text": "Our Ridgeview chapter upgraded back in April, and when their November renewal came through the full 1,200 dollar amount posted with nothing subtracted for what they already paid."
