        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 338227,
            "end": 393573,
            "text": "Thanks, that gives me a clearer picture, one follow up though."
          },
          {
            "start": 393574,
            "end": 430471,
            "text": "Can you tell me roughly how many accounts this hit on that last cycle, and do you have a specific invoice number or date I can pull up?"
