          {
            "start": 93334,
            "end": 110833,
            "text": "Hey there, good to have you."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 116667,
            "end": 175000,
            "text": "We wanted to cover a couple of items today, one of them is a bit more pressing."
