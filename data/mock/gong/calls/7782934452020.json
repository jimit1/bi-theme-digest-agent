      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 195457,
            "end": 203435,
            "text": "Appreciate the detail, let me ask a quick follow up."
          },
          {
            "start": 203436,
            "end": 227368,
            "text": "How many donors does that affect roughly, and was this during a specific campaign?"
