      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 344167,
            "end": 379167,
            "text": "We have donors who asked to be reminded by mail only, and the system still emails them pledge reminders on top of that."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 385000,
            "end": 390833,
            "text": "About 60 of our mail only donors got the pledge reminders during the November campaign even though they opted out of that channel entirely."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 408333,
            "end": 455000,
            "text": "Good context, let me ask about one specific piece of it."
          },
          {
            "start": 455001,
            "end": 466667,
            "text": "How many donors does that affect roughly, and was this during a specific campaign?"
