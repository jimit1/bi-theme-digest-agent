      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 95734,
            "end": 111690,
            "text": "We wanted to cover a couple of items today, one of them is a bit more pressing."
          },
          {
            "start": 111691,
            "end": 123657,
            "text": "It has been a fairly normal month for us, a couple of things came up though."
