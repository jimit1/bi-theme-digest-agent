    "transcript": [
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 0,
            "end": 15873,
            "text": "Hi, sorry if I am a minute behind, glad to be here now."
          },
          {
            "start": 15874,
            "end": 55556,
            "text": "Hey, thanks for carving out time today."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 63492,
            "end": 91270,
            "text": "Hi, thanks for making room for this on your calendar."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 99206,
            "end": 107143,
            "text": "We put together a short list of items for today's call."
          },
          {
            "start": 107144,
            "end": 146825,
            "text": "Overall things are going fine, just a few things we wanted to flag."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 150794,
            "end": 154762,
            "text": "Glad to hear things are generally steady, let's dig into the specifics."
          },
          {
            "start": 154763,
            "end": 170635,
            "text": "Glad to make time for this, let's walk through the list."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 182540,
            "end": 206349,
            "text": "Pledge reminders keep going out on the standard schedule even for donors who told us they only want a single reminder before the campaign closes."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 210317,
            "end": 242063,
            "text": "We have around 140 donors who asked for a single reminder only, and the system sent all of them the full three part schedule anyway during our spring campaign."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 246032,
            "end": 277778,
            "text": "Thanks for the specifics, I have a quick question before we move on."
          },
          {
            "start": 277779,
            "end": 301587,
            "text": "How many donors does that affect roughly, and was this during a specific campaign?"
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 309524,
            "end": 329365,
            "text": "It was about 140 donors, all during the spring campaign that closed in May."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 333333,
            "end": 345238,
            "text": "Thanks, let's take a quick detour, anything else new on your end?"
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 349206,
            "end": 365079,
            "text": "A couple of staff asked for more hands on training recently."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 376984,
            "end": 416667,
            "text": "Glad to hear you are investing in training, that usually pays off."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 428571,
            "end": 448413,
            "text": "We actually had one of our long time donors, Marguerite Odom, ask about this at the gala last month."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 456349,
            "end": 480159,
            "text": "Glad to hear the renewal cycle is moving along smoothly."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 484127,
            "end": 503968,
            "text": "A couple of part time staff moved into full time roles."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 515873,
            "end": 535714,
            "text": "Sounds like a lot of change, hope the transition goes smoothly."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 543651,
            "end": 567460,
            "text": "We recorded a few training sessions so new staff can watch them later."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 571429,
            "end": 611111,
            "text": "Happy to help put together some training resources if that would be useful."
