        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 1202257,
            "end": 1208652,
            "text": "I have to say, the fundraising platform has been smooth to use with our team all season, genuinely impressed with how it holds up during a campaign push."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 1227837,
            "end": 1272602,
            "text": "Sounds like a mild fall so far, hope it stays that way."
