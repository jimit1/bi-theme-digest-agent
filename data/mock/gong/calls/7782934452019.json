        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 1285392,
            "end": 1323762,
            "text": "We just brought on a new coordinator last month."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 1330157,
            "end": 1374922,
            "text": "Let us know if we can help get anyone up to speed."
