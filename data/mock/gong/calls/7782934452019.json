        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 666667,
            "end": 670635,
            "text": "We added two people to the team this year."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 678571,
            "end": 702381,
            "text": "That is a lot of change at once, hope it goes well."
