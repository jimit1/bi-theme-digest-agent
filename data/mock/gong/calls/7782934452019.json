    "transcript": [
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 0,
            "end": 57555,
            "text": "Hi, sorry if I am a minute behind, glad to be here now."
          },
          {
            "start": 57556,
            "end": 83135,
            "text": "Hey, thanks for carving out time today."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 95925,
            "end": 115110,
            "text": "Hi, thanks for making room for this on your calendar."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 121505,
            "end": 153480,
            "text": "We put together a short list of items for today's call."
          },
          {
            "start": 153481,
            "end": 172665,
            "text": "Overall things are going fine, just a few things we wanted to flag."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 191850,
            "end": 230219,
            "text": "Glad to hear things are generally steady, let's dig into the specifics."
          },
          {
            "start": 230220,
            "end": 294169,
            "text": "Glad to make time for this, let's walk through the list."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 313354,
            "end": 319749,
            "text": "Pledge reminders keep going out on the standard schedule even for donors who told us they only want a single reminder before the campaign closes."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 332539,
            "end": 396489,
            "text": "We have around 140 donors who asked for a single reminder only, and the system sent all of them the full three part schedule anyway during our spring campaign."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 402884,
            "end": 422069,
            "text": "Thanks for the specifics, I have a quick question before we move on."
          },
          {
            "start": 422070,
            "end": 460439,
            "text": "How many donors does that affect roughly, and was this during a specific campaign?"
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 473229,
            "end": 479624,
            "text": "It was about 140 donors, all during the spring campaign that closed in May."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 498809,
            "end": 549969,
            "text": "Thanks, let's take a quick detour, anything else new on your end?"
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 569154,
            "end": 607524,
            "text": "We are putting together handouts to bring to the conference."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 620313,
            "end": 633103,
            "text": "Sounds like a good lineup, hope the travel goes smoothly."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 639498,
            "end": 671473,
            "text": "We actually had one of our long time donors, Marguerite Odom, ask about this at the gala last month."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 677868,
            "end": 716238,
            "text": "Glad to hear the heat wave finally broke."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 735423,
            "end": 754608,
            "text": "We have had a bit of turnover on our team this quarter."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 761003,
            "end": 812163,
            "text": "Congrats to the new hire, glad you found someone."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 831348,
            "end": 837743,
            "text": "We are looking forward to catching up with a few peers at the conference next month."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 844138,
            "end": 882508,
            "text": "Good to know the registration is set."
          }
        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 895298,
            "end": 940063,
            "text": "We are enjoying a nice stretch of mild weather right now."
