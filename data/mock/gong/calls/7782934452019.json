        ]
      },
      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 619048,
            "end": 630952,
            "text": "Our renewal reminders go out about six weeks before the anniversary date."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 642857,
            "end": 662698,
            "text": "Good to know, I will keep that in mind for the account review."
