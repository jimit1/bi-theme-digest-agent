      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 897783,
            "end": 917734,
            "text": "That sounds like a lot of back and forth, hope it evens out."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 925714,
            "end": 961626,
            "text": "We circulate a membership update to the board ahead of each meeting."
