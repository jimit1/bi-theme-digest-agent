    "transcript": [
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 0,
            "end": 7980,
            "text": "Hi, sorry if I am a minute behind, glad to be here now."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 19951,
            "end": 43892,
            "text": "Hi, thanks for joining, good to see you."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 47882,
            "end": 71823,
            "text": "We are doing fine day to day, a couple of specific things came up though."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 75813,
            "end": 115714,
            "text": "Let me know which item you would like to prioritize first."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 127685,
            "end": 167586,
            "text": "A good number of our members tell us the renewal notice never showed up, and when we check, it landed in their spam folder instead of the inbox."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 171576,
            "end": 199507,
            "text": "We checked our September 15th send and about 220 of our 1,400 members never got the notice in their inbox."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 207488,
            "end": 227438,
            "text": "Appreciate the detail, let me ask a quick follow up."
          },
          {
            "start": 227439,
            "end": 251379,
            "text": "Do you know which email providers those members are on, big consumer ones or something else?"
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 255369,
            "end": 259360,
            "text": "Most of the ones we checked were on one of the big consumer providers, a handful were on another."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 271330,
            "end": 303251,
            "text": "Appreciate that, changing topics for a moment, how has the rest of the quarter been?"
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 315222,
            "end": 319212,
            "text": "Our board chair has been asking about a couple of ongoing projects."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 323202,
            "end": 355123,
            "text": "Sounds like a productive session, strategic planning always takes a while."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 367094,
            "end": 391034,
            "text": "The events team has been busy getting everything ready."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 395025,
            "end": 418966,
            "text": "Noted, thanks for the update on the venue."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 422956,
            "end": 430936,
            "text": "The weather has been all over the place lately, hot one day and cold the next."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 438916,
            "end": 466847,
            "text": "Sounds like a mild fall so far, hope it stays that way."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 474828,
            "end": 482808,
            "text": "The board meeting ran a little long this time."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 494778,
            "end": 534680,
            "text": "Sounds like a full agenda, glad it all got covered."
