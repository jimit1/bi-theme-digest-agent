      {
        "speakerId": "c-02",
        "topic": null,
        "sentences": [
          {
            "start": 1563636,
            "end": 1590909,
            "text": "This year's renewal push started a little earlier than usual."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 1595455,
            "end": 1600000,
            "text": "Glad it is going smoothly, let us know if anything changes."
