        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 118516,
            "end": 164099,
            "text": "Hi, good to have you, ready to dive in whenever you are."
          },
          {
            "start": 164100,
            "end": 200565,
            "text": "Hi, glad this time worked for both of us."
          }
