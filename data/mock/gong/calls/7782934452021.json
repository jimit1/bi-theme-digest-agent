    "transcript": [
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 0,
            "end": 6460,
            "text": "Thanks for the invite, good to catch up."
          },
          {
            "start": 6461,
            "end": 9689,
            "text": "Hi, thanks for having us, ready when you are."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 12919,
            "end": 32298,
            "text": "Hi, glad this time worked for both of us."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 35528,
            "end": 45217,
            "text": "We wanted to use this time to walk through what has been coming up lately."
          },
          {
            "start": 45218,
            "end": 58137,
            "text": "Overall we are in decent shape, just a couple of things worth flagging."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 64596,
            "end": 90435,
            "text": "Happy to go through whatever is on your list today."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 93665,
            "end": 113043,
            "text": "We wanted to make sure we covered a couple of open items today."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 122733,
            "end": 155031,
            "text": "Happy to take these in whatever order makes sense to you."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 161491,
            "end": 190559,
            "text": "We have donors who asked to be reminded by mail only, and the system still emails them pledge reminders on top of that."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 193789,
            "end": 222857,
            "text": "About 60 of our mail only donors got the pledge reminders during the November campaign even though they opted out of that channel entirely."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 226087,
            "end": 229317,
            "text": "Thanks for explaining that, I want to get one more detail."
          },
          {
            "start": 229318,
            "end": 242236,
            "text": "How many donors does that affect roughly, and was this during a specific campaign?"
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 248696,
            "end": 251925,
            "text": "Around 60 donors, and it was the November campaign specifically."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 255155,
            "end": 280994,
            "text": "Good, let's shift gears for a minute, anything else worth mentioning?"
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 290683,
            "end": 300373,
            "text": "Our board likes to review the finances at every meeting."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 303602,
            "end": 326211,
            "text": "Sounds like a lot of board engagement lately, that is a good sign."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 329441,
            "end": 355280,
            "text": "We got an early frost last week that caught everyone off guard."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 361739,
            "end": 394037,
            "text": "Hope the storm did not cause too much trouble on your end."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 397267,
            "end": 429565,
            "text": "The board meeting ran a little long this time."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 436025,
            "end": 468323,
            "text": "Happy to provide any data that would help with the board report."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 474783,
            "end": 503851,
            "text": "It has been windy enough here to notice it on the drive in."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 507081,
            "end": 539379,
            "text": "That sounds like a lot of back and forth, hope it evens out."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 545839,
            "end": 568447,
            "text": "Our board has been pretty engaged with the strategic plan lately."
          }
        ]
      },
      {
        "speakerId": "2002",
        "topic": null,
        "sentences": [
          {
            "start": 574907,
            "end": 603975,
            "text": "Sounds like a full agenda, glad it all got covered."
          }
        ]
      },
      {
        "speakerId": "c-05",
        "topic": null,
        "sentences": [
          {
            "start": 610435,
            "end": 629814,
            "text": "It has been unusually warm here the last couple of weeks."
